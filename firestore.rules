rules_version = '2';

// Matheasy Firestore security rules.
//
// Offline-first, client-owned sync model (Stage 12): the app mirrors each
// user's learning data to `users/{uid}/state/{domain}`, which only the owner
// reads and writes.
//
// Server-managed fields on the `users/{uid}` document — `entitlement`,
// `usage`, `usageDaily`, `subscription`, `identity`, `stats` — are written ONLY
// by the Admin SDK (RevenueCat webhook, usage metering, progress aggregation),
// which bypasses these rules. Stage 14 gates the Pro-only Visual Learning
// Engine on the `entitlement` field server-side, so the client must not be able
// to forge it: the user document is therefore read-only to the client.
//
// The anti-abuse collections at the bottom go further and are not readable
// either. See the comment there for why.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // The user document itself holds server-managed fields — readable by its
    // owner, never client-writable (the Admin SDK provisions and updates it).
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;

      // Offline-first sync tree — fully client-owned.
      match /state/{document=**} {
        allow read, write: if isOwner(uid);
      }

      // Immutable progress events the app appends; the `aggregateProgress`
      // trigger folds them into the server-managed `stats` field.
      match /progressEvents/{eventId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid);
      }
    }

    // --- Anti-abuse collections: SERVER ONLY -------------------------------
    //
    // These three are the free-tier enforcement substrate. The Admin SDK
    // bypasses these rules, so `false` here means "Cloud Functions and nobody
    // else" — which is the whole design: a client that could read its own
    // installation document would learn its risk score and which uids the
    // device has carried, and a client that could write one could reset the
    // device's spent usage to zero and make the entire system decorative.
    //
    // There is nothing here a student needs. The app gets its meter from the
    // `usageStatus` callable, which returns a display value computed
    // server-side, never a document it could edit.

    // One doc per installation, keyed by SHA-256 of the installation ID.
    match /installations/{installationId} {
      allow read, write: if false;
    }

    // The append-only metering trail (uid, hashed installation, feature, verdict).
    match /usage_events/{eventId} {
      allow read, write: if false;
    }

    // Pre-aggregated daily counters for dashboards.
    match /analytics/{document=**} {
      allow read, write: if false;
    }

    // Raw solve-failure drill-down (anonymous, no uid) — server-written,
    // surfaced only through the admin `solveFailureReport` callable.
    match /solve_failures/{failureId} {
      allow read, write: if false;
    }
  }
}
